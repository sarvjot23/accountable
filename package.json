{
  "name": "accountable",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "uv run uvicorn accountable.main:app --app-dir backend --reload --reload-dir backend/accountable --port 8000",
    "dev:web": "npm run dev --workspace frontend",
    "seed": "node scripts/seed.mjs",
    "types": "node scripts/types.mjs",
    "test": "npm run test:trace && npm run test:types && npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:trace": "node --test scripts/check-trace.test.mjs && node scripts/check-trace.mjs --through-phase 5",
    "test:types": "node scripts/types.mjs --check",
    "test:backend": "uv run pytest",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.52.0",
    "concurrently": "^9.1.2"
  }
}
